[Unit]
Description=Halal OS Sovereign App Store Repository Microservice
After=network.target

[Service]
Type=simple
User=halal
Group=halal
WorkingDirectory=/usr/share/halalos/app-store
ExecStart=/usr/local/bin/app-store
Restart=always
RestartSec=3s
Environment=PORT=8080

# Hardening
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
